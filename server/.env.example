# DevOnboard server configuration. Copy to server/.env (gitignored) and adjust.
# Without MONGODB_URI the server falls back to an in-memory database seeded with demo data.

PORT=4000
JWT_SECRET=change-me-in-production
MONGODB_URI=
CORS_ORIGIN=http://localhost:5173

# Seeded demo accounts (created only when the database starts empty)
DEMO_MANAGER_PASSWORD=
DEMO_ENGINEER_PASSWORD=
