# DevOnboard Environment Variables
# Copy this file to .env and fill in real values before running any backend/CI integration.
# The static HTML boilerplates do NOT read these — they apply to a future backend or CI layer only.

# ─── GitHub Integration ────────────────────────────────────────────────────────
# Personal access token or GitHub App token for fetching commit history and repo metadata.
# Required scopes: repo (read), read:user
GITHUB_TOKEN=

# Default repository slug shown in the onboarding UI (format: org/repo)
DEVONBOARD_DEFAULT_REPO=enterprise/nexus-core-api

# Default branch to target for commit history and setup validation
DEVONBOARD_DEFAULT_BRANCH=main

# ─── Slack Integration ─────────────────────────────────────────────────────────
# Incoming Webhook URL for posting mentor assignment notifications to the team channel.
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Slack channel to notify on new engineer onboarding (e.g. #eng-onboarding)
SLACK_NOTIFY_CHANNEL=#eng-onboarding

# ─── Vault / SSO Integration ───────────────────────────────────────────────────
# Base URL for the HashiCorp Vault instance used for SSO token issuance.
DEVONBOARD_VAULT_URL=

# ─── Application ───────────────────────────────────────────────────────────────
# Environment flag used by any backend layer.
NODE_ENV=development
